# Порт HTTP-сервера Ktor
PORT=8080

# Подключение к PostgreSQL (Neon отдает строку postgresql://user:pass@host/db?sslmode=require).
# Если DATABASE_URL не задан, используется локальная файловая БД H2.
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# JDBC URL локальной базы H2 (используется только если DATABASE_URL не задан)
H2_URL=jdbc:h2:file:./data/timecapsule;DB_CLOSE_DELAY=-1

# ОБЯЗАТЕЛЬНЫЙ 32-байтный ключ AES-256-GCM в формате Base64.
# Сгенерируйте уникальный ключ командой: ./generate-aes-key.sh
CAPSULE_AES_KEY=

# Google OAuth 2.0 Web Client ID для проверки Google ID-токенов
GOOGLE_WEB_CLIENT_ID=

# Обновление Android-приложения (публичный GET /api/v1/app/version)
# APK URL должен использовать только https:// (иначе клиент получит пустую строку)
LATEST_VERSION_CODE=1
LATEST_VERSION_NAME=1.0.0
LATEST_APK_URL=
LATEST_APK_SHA256=
LATEST_CHANGELOG=
LATEST_MIN_SUPPORTED_VERSION_CODE=1


