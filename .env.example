# Порт HTTP-сервера Ktor
PORT=8080

# JDBC URL базы данных H2
H2_URL=jdbc:h2:file:./data/timecapsule;DB_CLOSE_DELAY=-1

# ОБЯЗАТЕЛЬНЫЙ 32-байтный ключ AES-256-GCM в формате Base64.
# Сгенерируйте уникальный ключ командой: ./generate-aes-key.sh
CAPSULE_AES_KEY=

# Google OAuth 2.0 Web Client ID для проверки Google ID-токенов
GOOGLE_WEB_CLIENT_ID=

